<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.jimwas.recorder.service</string>
<key>ProgramArguments</key><array><string>/var/jb/Applications/JWRRecorderApp.app/JWRRecorderApp</string><string>--service</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict>
<key>SuccessfulExit</key><false/>
<key>Crashed</key><true/>
</dict>
<key>UserName</key><string>mobile</string>
<key>ProcessType</key><string>Interactive</string>
<key>StandardOutPath</key><string>/tmp/jwr-service.log</string>
<key>StandardErrorPath</key><string>/tmp/jwr-service-error.log</string>
<key>WorkingDirectory</key><string>/var/mobile</string>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>/usr/bin:/bin:/var/jb/usr/bin:/var/jb/bin</string>
<key>DYLD_LIBRARY_PATH</key><string>/var/jb/usr/lib:/usr/lib</string>
</dict>
</dict></plist>
